{
  "name": "sds-db-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "process:account-deletions": "tsx scripts/process-account-deletions.ts",
    "process:notifications": "tsx scripts/process-notifications.ts",
    "process:expired-messages": "tsx scripts/process-expired-messages.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:status": "tsx scripts/migrate.ts status",
    "security:audit": "node scripts/security-audit.mjs",
    "security:gate": "node scripts/security-gate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "dotenv": "^17.2.1",
    "fastify": "^5.5.0",
    "firebase-admin": "^14.3.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.34.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
