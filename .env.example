NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sds_db
JWT_SECRET=replace-with-at-least-32-random-characters
GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
STORAGE_REGION=us-east-1
STORAGE_BUCKET=sds-db-private
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
FILE_MAX_BYTES=5368709120
UPLOAD_URL_TTL_SECONDS=600

# Push notifications (server-side only)
PUSH_PROVIDER_ENABLED=false
# 32-byte key encoded as base64. Never ship this to Flutter.
PUSH_TOKEN_ENCRYPTION_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Messaging reliability
# No additional secrets are required. Client message IDs are random UUIDs generated by the app.
